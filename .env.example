# Environment Variables Configuration Template
# Copy this file to .env.local for local development

# API Base URL - this will be replaced at build time
# Also used for Socket.io connection
REACT_APP_API_BASE_URL=http://localhost:8081

# For Azure Static Web Apps:
# Set REACT_APP_API_BASE_URL in Azure portal Application Settings to:
# https://api-web-app-cjgyegghcqadgve7.eastus2-01.azurewebsites.net
