# Environment Variables Configuration Template
# Copy this file to .env.local for local development

# API Base URL - this will be replaced at build time
# Also used for Socket.io connection
# OPTIONAL: If not set, will auto-detect based on hostname
# - Local development: defaults to http://localhost:8081
# - Production: defaults to https://api-web-app-cjgyegghcqadgve7.eastus2-01.azurewebsites.net
REACT_APP_API_BASE_URL=http://localhost:8081

# For Azure Static Web Apps (OPTIONAL):
# You can set REACT_APP_API_BASE_URL in Azure portal Application Settings to override auto-detection:
# https://api-web-app-cjgyegghcqadgve7.eastus2-01.azurewebsites.net
# 
# NOTE: If not set in Azure, the app will automatically detect production and use the hardcoded backend URL
